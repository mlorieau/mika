# ============================================================
# ZONE85 — Variables d'environnement
# Copier ce fichier en .env et renseigner les valeurs.
# Ne jamais committer le fichier .env dans git.
# ============================================================

# Environnement : dev | prod
APP_ENV=prod

# Base de données
DB_HOST=localhost
DB_PORT=3306
DB_NAME=zone85
DB_USER=zone85_user
DB_PASS=CHANGER_CE_MOT_DE_PASSE

# Brevo (emails transactionnels)
# Laisser vide pour utiliser mail() en fallback
BREVO_API_KEY=

# Analytics — laisser vide pour désactiver
GA4_MEASUREMENT_ID=
MATOMO_URL=
MATOMO_SITE_ID=0

# Outils de diagnostic (jamais true en prod)
DEV_TOOLS_ALLOWED=false
